

---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Dashboard | Little Notes</title>
  </head>

  <body class="min-h-screen bg-[#F7F6EF]">

    <main class="max-w-4xl mx-auto px-6 py-12">

      <!-- Header -->
      <header class="flex items-center justify-between mb-12">
        <div>
          <h1 class="text-3xl font-bold text-[#626B43] tracking-tight">
            Little Notes
          </h1>
          <p class="text-[#92977B] mt-1">
            Your personal space for thoughts.
          </p>
        </div>

        <button
          id="logout-button"
          class="border border-[#AAB08B] text-[#626B43] rounded-full px-5 py-2 hover:bg-[#F0F0E5] transition duration-300"
        >
          Log out
        </button>
      </header>

      <!-- Welcome section -->
      <section class="mb-10">
        <h2 class="text-2xl font-semibold text-[#626B43] tracking-tight">
          Welcome back!
        </h2>

        <p id="user-email" class="text-[#92977B] mt-2">
          Loading your account...
        </p>
      </section>

      <!-- Notes section -->
      <section>

        <!-- Create note form -->
        <div class="bg-[#FFFDF7] border border-[#E5E5D5] rounded-[1.5rem] p-6 mb-8 shadow-sm">

          <h2 class="text-xl font-semibold text-[#626B43] mb-5">
            Create a note
          </h2>

          <form id="note-form" class="space-y-4">

            <input
              type="text"
              id="note-title"
              placeholder="Note title"
              required
              class="w-full bg-[#F7F6EF] border border-[#E5E5D5] rounded-xl p-3 text-[#626B43] placeholder:text-[#A5A78F] focus:outline-none focus:border-[#929B70] focus:ring-2 focus:ring-[#929B70]/20 transition duration-300"
            />

            <textarea
              id="note-content"
              placeholder="Write something..."
              required
              rows="5"
              class="w-full bg-[#F7F6EF] border border-[#E5E5D5] rounded-xl p-3 text-[#626B43] placeholder:text-[#A5A78F] focus:outline-none focus:border-[#929B70] focus:ring-2 focus:ring-[#929B70]/20 transition duration-300 resize-y"
            ></textarea>

            <button
              type="submit"
              class="bg-[#727C50] text-white rounded-full px-7 py-3 hover:bg-[#59623D] transition duration-300 shadow-sm"
            >
              Save note
            </button>

          </form>

          <p id="form-message" class="text-sm text-[#92977B] mt-3"></p>

        </div>

        <!-- Display existing notes -->
        <div>

          <h2 class="text-xl font-semibold text-[#626B43] mb-5">
            Your notes
          </h2>

          <p id="status-message" class="text-[#92977B] mb-5">
            Loading your notes...
          </p>

          <div id="notes-list" class="grid gap-4">
          </div>

        </div>

      </section>

    </main>

  </body>
</html>

<script>
  import { supabase } from "../lib/supabase.js";

  // Get elements from the HTML
  const userEmail = document.querySelector("#user-email");
  const logoutButton = document.querySelector("#logout-button");
  const statusMessage = document.querySelector("#status-message");
  const notesList = document.querySelector("#notes-list");

  const noteForm = document.querySelector("#note-form");
  const noteTitle = document.querySelector("#note-title");
  const noteContent = document.querySelector("#note-content");
  const formMessage = document.querySelector("#form-message");

  // Load the dashboard
  async function loadDashboard() {

    // Clear previously displayed notes
    notesList.innerHTML = "";

    // 1. Check who is logged in
    const { data: userData, error: userError } =
      await supabase.auth.getUser();

    if (userError || !userData.user) {
      window.location.href = "/login";
      return;
    }

    // 2. Display the user's email
    userEmail.textContent = userData.user.email;

    // 3. Get notes from Supabase
    const { data: notes, error } = await supabase
      .from("notes")
      .select("id, title, content, created_at")
      .order("created_at", { ascending: false });

    // 4. Check for database errors
    if (error) {
      statusMessage.textContent = error.message;
      return;
    }

    // 5. Check whether the user has notes
    if (notes.length === 0) {
      statusMessage.textContent = "You don't have any notes yet.";
      return;
    }

    // 6. Display the notes
    statusMessage.textContent = "";

    notes.forEach((note) => {

      const noteCard = document.createElement("article");

      noteCard.className =
        "bg-white border border-stone-200 rounded-xl p-6";

      const title = document.createElement("h3");
      title.className = "text-lg font-semibold text-stone-900";
      title.textContent = note.title;

      const content = document.createElement("p");
      content.className = "text-stone-600 mt-2";
      content.textContent = note.content;

      const date = document.createElement("p");
      date.className = "text-xs text-stone-400 mt-4";

      date.textContent = new Date(
        note.created_at
      ).toLocaleDateString();

      // Create delete button
      const deleteButton = document.createElement("button");

      deleteButton.textContent = "Delete";

      deleteButton.className =
        "mt-4 text-sm text-red-600 hover:text-red-800";

      // Delete this particular note
      deleteButton.addEventListener("click", () => {
        deleteNote(note.id);
      });

      noteCard.append(title, content, date, deleteButton);

      notesList.appendChild(noteCard);

    });
  }

  // Delete a note
  async function deleteNote(noteId) {

    // Ask the user for confirmation
    const confirmed = confirm(
      "Are you sure you want to delete this note?"
    );

    if (!confirmed) {
      return;
    }

    // Delete the note from Supabase
    const { error } = await supabase
      .from("notes")
      .delete()
      .eq("id", noteId);

    // Check for errors
    if (error) {
      console.error("Delete error:", error);
      alert("Could not delete note: " + error.message);
      return;
    }

    // Reload the dashboard
    await loadDashboard();

  }

  // Log out the current user
  logoutButton.addEventListener("click", async () => {

    logoutButton.disabled = true;
    logoutButton.textContent = "Logging out...";

    const { error } = await supabase.auth.signOut();

    if (error) {
      console.error(error);

      logoutButton.disabled = false;
      logoutButton.textContent = "Log out";

      alert("Could not log out. Please try again.");
      return;
    }

    // Redirect to homepage
    window.location.href = "/";

  });

  // Create a new note when the form is submitted
  noteForm.addEventListener("submit", async (event) => {

    // Stop the browser from refreshing the page
    event.preventDefault();

    // Get the values entered by the user
    const title = noteTitle.value.trim();
    const content = noteContent.value.trim();

    if (!title || !content) {
      formMessage.textContent = "Please fill in both fields.";
      return;
    }

    formMessage.textContent = "Saving your note...";

    // Get the currently logged-in user
    const { data: userData, error: userError } =
      await supabase.auth.getUser();

    if (userError || !userData.user) {
      formMessage.textContent = "You must be logged in.";
      return;
    }

    // Insert the note into Supabase
    const { error } = await supabase
      .from("notes")
      .insert({
        user_id: userData.user.id,
        title: title,
        content: content
      });

    if (error) {
      console.error(error);
      formMessage.textContent = error.message;
      return;
    }

    // Clear the form after successful creation
    noteForm.reset();

    formMessage.textContent = "Note created successfully!";

    // Reload the notes from Supabase
    await loadDashboard();

  });

  // Initially load the dashboard
  loadDashboard();
</script>

