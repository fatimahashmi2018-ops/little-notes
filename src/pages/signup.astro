---
import "../styles/global.css";
---


<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign up | Little Notes</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-[#F7F6EF] px-5 py-12 flex items-center justify-center font-['DM_Sans',sans-serif] text-[#626B43] antialiased">

    <main class="w-full max-w-120">

      <!-- Brand -->
      <div class="mb-8 text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#727C50] text-[#FFFDF7] shadow-sm">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="27"
            height="27"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z" />
          </svg>
        </div>

        <p class="text-sm font-semibold tracking-[0.18em] uppercase text-[#727C50]">
          Little Notes
        </p>
      </div>

      <!-- Signup Card -->
      <div class="rounded-[28px] border border-[#E5E5D5] bg-[#FFFDF7] px-7 py-10 shadow-[0_12px_50px_rgba(98,107,67,0.06)] sm:px-12 sm:py-12">

        <!-- Heading -->
        <div class="mb-9 text-center">
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-[#92977B]">
            A little space for you
          </p>

          <h1 class="font-['Playfair_Display',serif] text-4xl font-semibold tracking-tight text-[#626B43] sm:text-[42px]">
            Your thoughts,<br />all in one place.
          </h1>

          <p class="mx-auto mt-4 max-w-75 text-sm leading-7 text-[#92977B]">
            Create an account and start collecting the little things worth remembering.
          </p>
        </div>

        <!-- Signup Form -->
        <form id="signup-form" class="space-y-6" novalidate>

          <!-- Email -->
          <div>
            <label
              for="email"
              class="mb-2 block text-sm font-semibold text-[#626B43]"
            >
              Email address
            </label>

            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="w-full rounded-xl border border-[#E5E5D5] bg-[#F7F6EF] px-4 py-4 text-sm text-[#626B43] outline-none transition-all placeholder:text-[#A5A78F] hover:border-[#AAB08B] focus:border-[#929B70] focus:bg-[#FFFDF7] focus:ring-4 focus:ring-[#929B70]/10"
            />
          </div>

          <!-- Password -->
          <div>
            <label
              for="password"
              class="mb-2 block text-sm font-semibold text-[#626B43]"
            >
              Password
            </label>

            <input
              type="password"
              id="password"
              name="password"
              required
              minlength="6"
              autocomplete="new-password"
              placeholder="At least 6 characters"
              aria-describedby="password-hint"
              class="w-full rounded-xl border border-[#E5E5D5] bg-[#F7F6EF] px-4 py-4 text-sm text-[#626B43] outline-none transition-all placeholder:text-[#A5A78F] hover:border-[#AAB08B] focus:border-[#929B70] focus:bg-[#FFFDF7] focus:ring-4 focus:ring-[#929B70]/10"
            />

            <p id="password-hint" class="mt-2 text-xs text-[#92977B]">
              Use at least 6 characters.
            </p>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="mt-2 w-full rounded-full bg-[#727C50] px-5 py-4 text-sm font-semibold text-white shadow-sm transition-all hover:bg-[#59623D] hover:shadow-md focus:outline-none focus-visible:ring-4 focus-visible:ring-[#929B70]/30 active:scale-[0.99] disabled:cursor-not-allowed disabled:opacity-60"
          >
            Create my account
            <span aria-hidden="true" class="ml-1">→</span>
          </button>

          <!-- Feedback -->
          <p
            id="message"
            role="status"
            aria-live="polite"
            class="min-h-5 text-center text-sm text-[#727C50]"
          ></p>

        </form>

        <!-- Login Link -->
        <div class="mt-7 border-t border-[#E5E5D5] pt-7 text-center">
          <p class="text-sm text-[#92977B]">
            Already have an account?
            <a
              href="/login"
              class="ml-1 font-semibold text-[#626B43] underline decoration-[#AAB08B] underline-offset-4 transition hover:text-[#727C50]"
            >
              Log in
            </a>
          </p>
        </div>

      </div>

      <!-- Footer -->
      <p class="mt-7 text-center text-xs tracking-wide text-[#A5A78F]">
        A quiet little corner of the internet.
      </p>

    </main>

  </body>
</html>



<script>
  import { supabase } from "../lib/supabase.js";

  // STEP 1: Find the HTML elements
  const form = document.querySelector<HTMLFormElement>(
    "#signup-form"
  );

  const emailInput = document.querySelector<HTMLInputElement>(
    "#email"
  );

  const passwordInput = document.querySelector<HTMLInputElement>(
    "#password"
  );

  const message = document.querySelector<HTMLElement>(
    "#message"
  );

  // STEP 2: Check that all elements exist
  if (!form || !emailInput || !passwordInput || !message) {
    throw new Error("Signup form elements not found!");
  }

  // STEP 3: Listen for form submission
  form.addEventListener("submit", async (event) => {

    // Prevent the page from refreshing
    event.preventDefault();

    // Show loading message
    message.textContent = "Creating your account...";

    // STEP 4: Get the user's input
    const email = emailInput.value.trim();
    const password = passwordInput.value;

    try {

      // STEP 5: Send signup request to Supabase
      const { data, error } = await supabase.auth.signUp({
        email: email,
        password: password,
      });

      // STEP 6: Check for errors
      if (error) {
        message.textContent = error.message;
        return;
      }

      // STEP 7: Show success message
      message.textContent =
        "Account created! Check your email for confirmation.";

      console.log(data);

    } catch (err) {

      // Handle unexpected errors
      console.error(err);

      message.textContent =
        "Something went wrong. Please try again.";

    }

  });
</script>
