---
import "../styles/global.css";
---


<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Little Notes</title>
  </head>

  <body class="bg-[#F7F6EF] min-h-screen flex items-center justify-center">

    <div class="text-center bg-[#FFFDF7] border border-[#E5E5D5] rounded-[2rem] shadow-sm px-10 py-14 mx-5 max-w-xl">

      <h1 class="text-4xl font-bold text-[#626B43] tracking-tight">
        Welcome to Little Notes!
      </h1>

      <div class="flex flex-wrap justify-center gap-4 mt-8">

        <a
          href="/login"
          class="bg-[#727C50] text-white px-7 py-3 rounded-full hover:bg-[#59623D] transition duration-300 shadow-sm"
        >
          Log in
        </a>

        <a
          href="/signup"
          class="border border-[#AAB08B] text-[#626B43] px-7 py-3 rounded-full hover:bg-[#F0F0E5] transition duration-300"
        >
          Sign up
        </a>

      </div>

    </div>

  </body>
</html>
